# =============================================================================
# opencode Docker Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ---- LLM Provider Configuration ----
OPENCODE_PROVIDER_ID=
OPENCODE_API_KEY=
OPENCODE_MODEL_URL=
OPENCODE_MODEL_ID=
OPENCODE_MODEL_PATH=

# ---- SSH (optional, TUI mode only) ----
# Paste your private SSH key content (no quotes needed)
# OPENCODE_SSH_KEY=

# 'host' target connects to host.docker.internal
HOST_SSH_USER=opencode
HOST_SSH_SHELL=zsh

# Dynamic SSH targets: any {NAME}_SSH_HOST creates 'ssh-{name}'
# Example: NAS_SSH_HOST=192.168.1.100 generates 'ssh-nas'
# NAS_SSH_USER=admin
# NAS_SSH_SHELL=bash
# PROXMOX_SSH_HOST=192.168.1.10
# PROXMOX_SSH_USER=root

# ---- CORS (web mode) ----
OPENCODE_CORS_URL=https://opencode.mydomain.net

# ---- Permission Overrides (optional) ----
# Uncomment to override default permission prompts
# OPENCODE_PERM_EDIT=accept
# OPENCODE_PERM_WRITE=accept
# OPENCODE_PERM_READ=accept
# OPENCODE_PERM_GREP=accept
# OPENCODE_PERM_GLOB=accept
# OPENCODE_PERM_LIST=accept
# OPENCODE_PERM_LSP=accept
# OPENCODE_PERM_PATCH=accept
# OPENCODE_PERM_SKILL=accept
# OPENCODE_PERM_TODOWRITE=accept
# OPENCODE_PERM_TODOREAD=accept
# OPENCODE_PERM_WEBFETCH=accept
# OPENCODE_PERM_WEBSEARCH=accept

# Obsidian vault root (host path, not committed in real .env)
VAULT_ROOT=/path/to/Obsidian Vault
